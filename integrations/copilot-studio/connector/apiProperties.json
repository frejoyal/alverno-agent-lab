    "connectionParameters": {
      "token": {
        "type": "oauthSetting",
        "oAuthSettings": {
          "identityProvider": "aad",
          "clientId": "<identifiant de l'application cliente du connecteur>",
          "scopes": ["<ALVERNO_M365_AUDIENCE>/.default"],
          "redirectMode": "GlobalPerConnector",
          "redirectUrl": "https://global.consent.azure-apim.net/redirect",
          "properties": {"IsFirstParty": "False"},
          "customParameters": {
            "loginUri": {"value": "https://login.microsoftonline.com"},
            "tenantId": {"value": "<ALVERNO_M365_TENANT_ID>"},
            "resourceUri": {"value": "<ALVERNO_M365_AUDIENCE>"},
            "enableOnbehalfOfLogin": {"value": "false"}
          }
        }
      },
      "gateway": {
        "type": "gatewaySetting",
        "gatewaySettings": {"dataSourceType": "CustomConnector", "connectionDetails": []},
        "uiDefinition": {
          "constraints": {"tabIndex": 4, "required": "true", "capability": ["gateway"]}
        }
      }
    },
    "iconBrandColor": "#1F4E79",
    "capabilities": ["gateway"],
    "policyTemplateInstances": [],
